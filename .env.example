# Postgres URL, or pglite:<dir> for embedded (default pglite:./.data/pglite)
# DATABASE_URL=postgres://billing:billing@localhost:5432/billing

RPC_URL=https://api.devnet.solana.com
# RPC_WS_URL=wss://api.devnet.solana.com

# Merchant or whitelisted puller keypair (Solana CLI JSON). Omit for read-only mode.
# KEYPAIR_PATH=./keys/puller.json

# managed (plans the key can charge) | all | comma-separated plan addresses
PLAN_SCOPE=managed
# DESTINATION_OWNER=<wallet that receives funds; must be in the plan's destinations if any are set>

DRY_RUN=true
SYNC_INTERVAL_SECS=30
CHARGE_INTERVAL_SECS=60
RETRY_SCHEDULE_SECS=3600,21600,86400,259200
# Charges per transaction for one plan (max that fits is 4; 1 disables batching)
CHARGE_BATCH_SIZE=4
GRACE_PERIOD_SECS=259200
# COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=1000

API_HOST=127.0.0.1
API_PORT=8787
# API_KEY=change-me-to-a-long-random-string

# Signed webhooks (Standard Webhooks). Generate a secret with: pnpm billing webhook-secret
# WEBHOOK_URL=https://example.com/hooks/billing
# WEBHOOK_SECRET=whsec_...           # comma-separated during rotation
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_INTERVAL_SECS=5
# WEBHOOK_RETRY_SCHEDULE_SECS=10,60,300,1800,7200,21600,43200,86400

# Payment ledger from the program's events (pulls by any puller)
# INGEST_EVENTS=true
# INGEST_COMMITMENT=finalized
# INGEST_MAX_TX_PER_PASS=500
# INGEST_BACKFILL=true
