# Postgres URL, or pglite:<dir> for embedded (default pglite:./.data/pglite)
# DATABASE_URL=postgres://billing:billing@localhost:5432/billing

RPC_URL=https://api.devnet.solana.com
# RPC_WS_URL=wss://api.devnet.solana.com

# Merchant or whitelisted puller keypair (Solana CLI JSON). Omit for read-only mode.
# KEYPAIR_PATH=./keys/puller.json

# managed (plans the key can charge) | all | comma-separated plan addresses
PLAN_SCOPE=managed
# DESTINATION_OWNER=<wallet that receives funds; must be in the plan's destinations if any are set>

DRY_RUN=true
SYNC_INTERVAL_SECS=30
CHARGE_INTERVAL_SECS=60
RETRY_SCHEDULE_SECS=3600,21600,86400,259200
GRACE_PERIOD_SECS=259200
# COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=1000

API_HOST=127.0.0.1
API_PORT=8787
# API_KEY=change-me-to-a-long-random-string
